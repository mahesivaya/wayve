# Root-level compose interpolation variables.
#
# scripts/smoke.sh copies this file to `.env` when a fresh clone /
# CI runner doesn't already have one (compose hard-fails on missing
# env files referenced via --env-file). For real local dev the
# values usually need editing; for CI / smoke they're fine as-is.
POSTGRES_USER=rwayve
POSTGRES_PASSWORD=rwayve_password
POSTGRES_DB=rwayve
POSTGRES_PORT=5432
