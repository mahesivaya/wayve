# Processed by the nginx image entrypoint (envsubst) at container start:
#   /etc/nginx/templates/nginx.conf.template  ->  /etc/nginx/nginx.conf
events {}

http {
    access_log off;
    error_log /var/log/nginx/error.log warn;
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 80;
        server_name ${NGINX_HOST};

        # Stripe Elements requires js.stripe.com (script + frame) and
        # hooks.stripe.com (frame, for 3D Secure). connect-src already
        # permits api.stripe.com via the blanket `https:` fallback.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${CSP_CONNECT_SRC} https: ws: wss:; frame-src https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

        # OWASP-recommended hardening headers. Tested by the DAST stage
        # of .github/workflows/security.yml. `frame-ancestors 'none'` in
        # the CSP above is the modern replacement for X-Frame-Options,
        # but the legacy header is still expected by older scanners.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # Resolve the backend by name PER REQUEST (via the resolver above)
        # instead of once at startup. Without this, recreating the backend
        # container (which gives it a new Docker IP) leaves nginx proxying to
        # the stale IP until nginx itself is recreated — surfacing as 502s on
        # /api during local dev rebuilds. The frontend `/` location already
        # does this; mirror it for every backend upstream.
        set $backend_upstream backend:8080;

        location /api/ {
            proxy_pass http://$backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /gmail/ {
            proxy_pass http://$backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location /oauth/ {
            proxy_pass http://$backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # Inbound integration webhooks (Jira: /webhooks/fluxze_webhook)
        location /webhooks/ {
            proxy_pass http://$backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location /ws/ {
            proxy_pass http://$backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Keep idle WebSockets alive (default read timeout is 60s); backend
            # heartbeats every 25s.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location / {
            set $frontend_upstream frontend:5173;
            proxy_pass http://$frontend_upstream;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Branded maintenance page when an upstream (backend/frontend) is
        # unreachable. Only nginx-generated upstream-down errors hit this;
        # proxy_intercept_errors stays off (default), so the backend's own
        # JSON 4xx/5xx responses on /api pass through untouched.
        error_page 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
