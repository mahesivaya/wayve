# Processed by the nginx image entrypoint (envsubst) at container start:
#   /etc/nginx/templates/nginx.conf.template  ->  /etc/nginx/nginx.conf
# Only CSP_* environment variables are substituted (NGINX_ENVSUBST_FILTER),
# so nginx runtime vars ($host, $remote_addr, $http_upgrade) are left intact.
events {}

http {
    access_log off;
    error_log /var/log/nginx/error.log warn;

    # Max request body. nginx defaults to 1m, which rejects Drive/email file
    # uploads with "413 Request Entity Too Large" before they reach the backend.
    # The upload handler buffers the whole file in memory, so keep this bounded.
    client_max_body_size 50m;

    server {
        listen 80;

        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${CSP_CONNECT_SRC} https: ws: wss:; frame-src 'self' blob: https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

        # ✅ API
        location /api/ {
            # rewrite ^/api/(.*)$ /api/$1 break;
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # ✅ Gmail login
        location /gmail/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_redirect off;
        }

        # ✅ OAuth callback
        location /oauth/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_redirect off;
        }

        # ✅ Inbound integration webhooks (Jira: /webhooks/fluxze_webhook)
        location /webhooks/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_redirect off;
        }

        # ✅ WebSocket
        location /ws/ {
            proxy_pass http://backend:8080/ws/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            # Keep idle chat/call WebSockets alive — the default 60s read
            # timeout would silently kill a quiet connection. The backend pings
            # every 25s, so an hour is comfortable headroom.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # ✅ Frontend (ONLY ONE BLOCK)
        location / {
            proxy_pass http://frontend:5173/;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Branded maintenance page when an upstream is unreachable. Only
        # nginx-generated upstream-down errors hit this; proxy_intercept_errors
        # stays off (default), so the backend's own JSON 4xx/5xx responses on
        # /api pass through untouched.
        error_page 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
