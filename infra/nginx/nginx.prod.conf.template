# Processed by the nginx image entrypoint (envsubst) at container start:
#   /etc/nginx/templates/nginx.conf.template  ->  /etc/nginx/nginx.conf
events {}

http {
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # ---- HTTP (port 80) ----
    # Serves the ACME HTTP-01 challenge for Let's Encrypt and redirects every
    # other request to HTTPS.
    server {
        listen 80;
        server_name ${NGINX_HOST};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type "text/plain";
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ---- HTTPS (port 443) ----
    server {
        listen 443 ssl;
        http2 on;
        server_name ${NGINX_HOST};

        ssl_certificate     /etc/letsencrypt/live/${NGINX_HOST}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${NGINX_HOST}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # Stripe needs four allowances to render the Elements card form and
        # complete 3D Secure: load js.stripe.com (script-src), embed its
        # iframes (frame-src — Elements + hooks.stripe.com for 3DS), let
        # those iframes inject inline styles (style-src 'unsafe-inline'),
        # and call api.stripe.com (connect-src, already covered by the
        # blanket `https:` fallback below).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Vi7qArasfF0qOpumMGQa0m1H6Pynd8yml8w6qnJD568=' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${CSP_CONNECT_SRC} https: wss:; frame-src https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # frame-ancestors 'none' in the CSP above is the modern equivalent;
        # the legacy header is kept for older scanners and pre-CSP browsers.
        add_header X-Frame-Options "DENY" always;
        # `camera=(self)` and `microphone=(self)` let the WebRTC call code in
        # the same-origin page (useCallSession.ts) invoke getUserMedia. The
        # empty list `()` previously here blocked the API outright, with the
        # browser reporting a "Permissions policy violation" before the OS
        # mic/camera prompt could even show. Geolocation stays denied — no
        # code on this origin uses it.
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

        location /api/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # No trailing slash on proxy_pass — preserves the `/gmail/` prefix so
        # the backend's `/gmail/login` route receives the full path. A trailing
        # `/` would rewrite to `http://backend:8080/login` → 404.
        location /gmail/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # Same rule as `/gmail/`: preserve the prefix so Google's callback URL
        # `/oauth/callback?code=…` reaches the backend's matching route.
        location /oauth/ {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location /ws/ {
            proxy_pass http://backend:8080/ws/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Keep idle chat/call WebSockets alive. nginx's default
            # proxy_read_timeout is 60s, which silently closes a quiet socket
            # (the "chat box disables after a while" bug). The backend pings
            # every 25s, so 1h is ample headroom.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Stripe posts subscription/invoice events here. The backend mounts the
        # webhook at the ROOT (`/billing/webhook`, not under `/api`), so it needs
        # its own proxy rule. EXACT match only — `/billing` (no /webhook) is a
        # frontend SPA route, so we must not blanket-proxy `/billing/` to the
        # backend or the Billing page would 404.
        location = /billing/webhook {
            proxy_pass http://backend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # Long-cache the Vite-built bundles. Filenames in /assets/ are
        # content-hashed (e.g. `/assets/index.abc123.js`) so any content
        # change produces a new URL — `immutable` lets browsers skip
        # revalidation entirely on repeat visits, which is the single
        # biggest repeat-load win after the first page paint.
        #
        # `add_header` inside a `location` block REPLACES (not extends)
        # the server-level `add_header` set, so we re-emit the per-asset
        # security headers below. CSP and Permissions-Policy are skipped
        # — browsers only enforce them from the document response, not
        # from individual script/style asset responses.
        location /assets/ {
            proxy_pass http://frontend:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header X-Frame-Options "DENY" always;
        }

        location / {
            proxy_pass http://frontend:8080/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # index.html (and any other non-hashed entry) must NEVER be cached:
            # the file references content-hashed bundles in /assets/ which are
            # immutable forever; without this, a browser sitting on a stale
            # index.html keeps requesting the OLD hashed bundles and never sees
            # a deploy. The /assets/ location above keeps its own long cache.
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }
    }

    # ---- www.fluxze.com -> canonical ${NGINX_HOST} ----
    # The www host serves no app of its own; 301 everything to the
    # canonical apex host. Port 80 also serves the ACME challenge so www
    # can be added to the Let's Encrypt cert via `certbot --expand`. The
    # 443 block reuses the ${NGINX_HOST} cert — valid once that cert
    # includes www.fluxze.com as a SAN (expand step); until then it presents
    # a name-mismatch but nginx still starts fine.
    server {
        listen 80;
        server_name www.fluxze.com;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type "text/plain";
        }

        location / {
            return 301 https://${NGINX_HOST}$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name www.fluxze.com;

        ssl_certificate     /etc/letsencrypt/live/${NGINX_HOST}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${NGINX_HOST}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        return 301 https://${NGINX_HOST}$request_uri;
    }
}
