# =========================
# 🔧 BASIC
# =========================

set dotenv-load := true

db_url := "postgres://wayve_user:wayve_password@localhost:5432/wayve_dev"

# cargo/npm recipes run in ../backend or ../frontend. just resolves the
# [working-directory] path relative to THIS justfile's dir (infra/), and it
# must be a string literal — a variable like `backend_dir` will not parse.

[working-directory: '../backend']
run:
    cargo run

[working-directory: '../backend']
build:
    cargo build

[working-directory: '../backend']
release:
    cargo build --release

[working-directory: '../backend']
clean:
    cargo clean

# =========================
# 🧪 DEV
# =========================

[working-directory: '../backend']
dev:
    cargo watch -x run

[working-directory: '../backend']
fmt:
    cargo fmt

[working-directory: '../backend']
lint:
    cargo clippy -- -D warnings

# Mirrors CI: single-threaded (tests mutate process env / use serial_test).
# Pass extra args: `just test some_name` or `just test -- --exact path::to::it`.
[working-directory: '../backend']
test *ARGS:
    cargo test --no-fail-fast {{ARGS}} -- --test-threads=1

[working-directory: '../frontend']
fe-install:
    npm install

[working-directory: '../frontend']
fe-dev:
    npm run dev

[working-directory: '../frontend']
fe-build:
    npm run build

[working-directory: '../frontend']
fe-preview:
    npm run preview

[working-directory: '../frontend']
fe-lint:
    npm run lint

[working-directory: '../frontend']
fe-lint-css:
    npm run lint:css

# Type-check only (no emit) — matches the CI `tsc --noEmit` gate.
[working-directory: '../frontend']
fe-typecheck:
    npx tsc --noEmit

# Vitest one-shot. Pass args: `just fe-test path/to/file.test.tsx -t "name"`.
[working-directory: '../frontend']
fe-test *ARGS:
    npm test {{ARGS}}

[working-directory: '../frontend']
fe-test-watch:
    npm run test:watch

[working-directory: '../frontend']
fe-test-ui:
    npm run test:ui

# Full pre-push gate mirroring CI: backend lint + tests, frontend typecheck + tests.
check: lint test fe-typecheck fe-test

# =========================
# 🐳 DOCKER
# =========================

compose-dev := "docker compose -f docker-compose.dev.yml --env-file ../.env"
compose-prod := "docker compose -f docker-compose.prod.yml --env-file ../.env.production"

up:
    {{compose-dev}} up --build

up-d:
    {{compose-dev}} up -d --build

dev-up-workers:
    {{compose-dev}} --profile workers up --build

dev-down:
    {{compose-dev}} down

dev-logs:
    {{compose-dev}} logs -f

prod-up:
    {{compose-prod}} up -d --build

prod-down:
    {{compose-prod}} down

prod-logs:
    {{compose-prod}} logs -f

docker-build:
    {{compose-dev}} build

docker-logs:
    {{compose-dev}} logs -f

docker-restart:
    {{compose-dev}} down
    {{compose-dev}} up --build

# =========================
# 🗄️ DATABASE
# =========================

db-up:
    {{compose-dev}} up postgres_db

db-reset:
    {{compose-dev}} down -v
    {{compose-dev}} up -d postgres_db

db-shell:
    docker exec -it rwayve_postgres_dev psql -U wayve_user -d wayve_dev

# =========================
# 🔐 SQLx
# =========================

[working-directory: '../backend']
sqlx-prepare:
    DATABASE_URL={{db_url}} cargo sqlx prepare

[working-directory: '../backend']
sqlx-migrate:
    DATABASE_URL={{db_url}} sqlx migrate run

# =========================
# 📧 BACKEND + FRONTEND
# =========================

start-all:
    {{compose-dev}} up --build

restart-backend:
    {{compose-dev}} restart backend

restart-nginx:
    {{compose-dev}} restart nginx

# =========================
# 🔥 GMAIL SYNC DEBUG
# =========================

logs-backend:
    docker logs -f rwayve_backend_dev

# =========================
# 💳 STRIPE / BILLING (dev)
# =========================

# Forward Stripe webhooks to the local backend so subscription activation —
# the upgrade/payment flow — actually completes in dev. Stripe can't reach
# localhost, so without this a subscription is created in Stripe but never
# flips to `active` locally and the upgrade silently never lands.
#
# One-time setup:
#   1. brew install stripe/stripe-cli/stripe
#   2. stripe login
#   3. Run `just stripe-webhooks`; copy the printed `whsec_…` into
#      backend/.env as STRIPE_WEBHOOK_SECRET, then `just restart-backend`.
# Keep this running in a terminal while testing payments/upgrades.
# NOTE: the webhook is root-mounted at /billing/webhook (NOT /api/billing/...).
stripe-webhooks:
    stripe listen --forward-to localhost:8080/billing/webhook

# Fire a test event at the local webhook while `stripe-webhooks` is running,
# e.g. `just stripe-trigger invoice.paid`.
stripe-trigger EVENT="customer.subscription.updated":
    stripe trigger {{EVENT}}

# =========================
# 📝 CHANGELOG (git-cliff)
# =========================

# Regenerate the full CHANGELOG.md from Conventional Commits across all tags.
# Run from repo root (cliff.toml + .git live there). Requires `cargo install git-cliff`.
[working-directory: '..']
changelog:
    git-cliff --output CHANGELOG.md

# Preview the notes for the NEXT (unreleased) release without writing the file.
[working-directory: '..']
changelog-unreleased:
    git-cliff --unreleased

# Print just the notes for a specific tag, e.g. `just changelog-tag v2.2.2`
# — handy for pasting into a GitHub Release body. Renders the commit range
# between the previous tag and TAG (or from the repo root if TAG is the first).
[working-directory: '..']
changelog-tag TAG:
    #!/usr/bin/env bash
    set -euo pipefail
    prev="$(git describe --tags --abbrev=0 "{{TAG}}^" 2>/dev/null || true)"
    range="{{TAG}}"; [ -n "$prev" ] && range="$prev..{{TAG}}"
    git-cliff "$range" --tag "{{TAG}}" --strip all

# =========================
# ⚡ SHORTCUTS
# =========================

r: run
d: dev
u: up
ud: up-d
dd: dev-down
