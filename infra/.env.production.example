CSP_CONNECT_SRC=https://hadalspace.com wss://hadalspace.com
# Canonical host, and the second host served alongside it. The alias always
# serves the API; it serves pages too until NGINX_HOST_ALIAS_REDIRECT=on.
NGINX_HOST=hadalspace.com
NGINX_HOST_ALIAS=fluxze.com
# certbot --cert-name of the cert covering hadalspace.com, fluxze.com and both
# www hosts. The prod cert was first issued as fluxze.com and expanded.
NGINX_HOST_CERT_NAME=fluxze.com
# Turn on once desktop builds that only allow fluxze.com are out of use.
NGINX_HOST_ALIAS_REDIRECT=off
VITE_API_URL=
VITE_WS_BASE_URL=
