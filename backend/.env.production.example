ENV=production
RWAYVE_ENV=production
RWAYVE_ROLE=api
PORT=8080
FRONTEND_URL=https://fluxze.com
BACKEND_URL=https://fluxze.com
AUTH_COOKIE_SECURE=true

DATABASE_URL=postgres://wayve:change-me-long-random-password@postgres_db:5432/wayve
DATABASE_MAX_CONNECTIONS=20
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
AES_KEY=change-me-generate-with-openssl-rand-hex-32
AES_HKDF_SALT=change-me-generate-with-openssl-rand-hex-32

GOOGLE_CLIENT_SECRET_PATH=/app/client_secret.json
GOOGLE_OAUTH_REDIRECT_URI=https://fluxze.com/oauth/callback

# Outbound email via AWS SES (SMTP interface). Port 587 = STARTTLS, which is
# what the sender uses for any non-local host (do NOT use 465 / implicit TLS).
# SMTP_USER / SMTP_PASS are SES *SMTP credentials* generated in the SES console
# (SMTP settings -> Create SMTP credentials) — they are NOT your AWS access
# key/secret. SMTP_FROM must be an address on an identity you have *verified*
# in SES; while the account is in the SES sandbox, mail only reaches verified
# recipients until you request production access.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAIOSFODNN7EXAMPLE
SMTP_PASS=change-me-ses-smtp-password
SMTP_FROM=no-reply@maheshg.me

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GEMINI_API_KEY=
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=
RUST_LOG=info
