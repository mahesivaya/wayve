# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install

# No VITE_* build args: the bundle is environment-agnostic and reads its
# API/WS base at runtime from the backend's GET /api/config.
COPY . .
RUN npm run build

# Unprivileged variant: listens on 8080 instead of 80 so the worker can
# run as the `nginx` user without needing root for port binding. This
# image is fronted by the outer nginx proxy in
# `infra/nginx/nginx.prod.conf.template`, which now targets
# `frontend:8080`.
FROM nginxinc/nginx-unprivileged:1.29-alpine

# /etc/nginx and /usr/share/nginx/html are root-owned in the base image,
# so we briefly switch to root to apply the latest Alpine patches, drop
# the config + bundle, then return to the `nginx` user the base image
# already configured. `apk upgrade` clears the OS-package CVEs Trivy
# flags against this layer.
USER root
RUN apk upgrade --no-cache
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
USER nginx

EXPOSE 8080
