# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim

# Prevent some npm noise
ENV CI=true

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .

# Run as the pre-baked `node` user (uid 1000) — same reasoning as the
# non-dev variant.
RUN chown -R node:node /app
USER node

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
