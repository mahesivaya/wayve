{
  "name": "fluxze-desktop",
  "version": "0.1.0",
  "description": "Fluxze desktop app — native macOS shell around https://fluxze.com",
  "private": true,
  "author": "Fluxze",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "icon": "node make-icon.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fluxze.desktop",
    "productName": "Fluxze",
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    }
  }
}